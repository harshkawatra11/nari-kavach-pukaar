{
  "name": "pukaar",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @pukaar/web dev",
    "dev:relay": "pnpm --filter @pukaar/relay dev",
    "dev:wa": "node apps/wa-bridge/server.js",
    "build": "turbo run build",
    "lint": "pnpm --filter @pukaar/web lint",
    "test": "pnpm --filter @pukaar/core test && pnpm --filter @pukaar/relay test",
    "typecheck": "turbo run typecheck",
    "eval": "tsx eval/run.ts",
    "verify": "pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
