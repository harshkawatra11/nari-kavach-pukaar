# Pukaar runs on three local processes and one cloud project. Unlike some other
# repos in this account, this one does NOT run with zero keys: the whole product
# is a live voice call, and there is no offline impersonation of that worth
# demoing. What it does do is fail loudly and specifically, naming the missing
# variable and the file to put it in, rather than dying inside a fetch.

# Sarvam AI (https://dashboard.sarvam.ai) is speech to text, the reasoning
# model, and text to speech. One key covers all three. New accounts get Rs 100
# of credit, which is roughly four hours of continuous conversation at the
# Tier A rates in packages/core/src/cost.ts.
SARVAM_API_KEY=

# Which voice she hears. Any Bulbul v3 speaker name, lowercase. "simran" is a
# young female voice and is the default persona. See docs/ARCHITECTURE.md for
# the full speaker list.
SARVAM_SPEAKER=simran

# hi-IN, en-IN, or auto. "auto" is correct for Hinglish code-switching and is
# what the demo uses; the fixed codes are slightly faster.
SARVAM_LANGUAGE=auto

# Speech-to-text transport. "ws" is the realtime Sarvam socket and gives live
# interim transcripts, which is what makes the demo obviously not a recording.
# "rest" is the turn-based fallback tier: it works, it is just not live.
STT_MODE=ws

# Text-to-speech transport. "rest" returns a complete WAV per sentence and is
# the proven path. "ws" is lower latency and streams, and is the Tier B demo
# path on the deck's architecture slide. Start on rest.
TTS_MODE=rest

# Firestore. Service account scoped to roles/datastore.user only. The private
# key is a single line with literal \n sequences; the loader converts them.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Where the relay reaches the web app to raise an alarm, and the shared secret
# that stops anything else on the machine from posting a fake one.
WEB_ORIGIN=http://localhost:3000
RELAY_SHARED_SECRET=

# Where the browser reaches the voice relay.
NEXT_PUBLIC_RELAY_URL=ws://localhost:8787

# The WhatsApp bridge. Leave blank to skip WhatsApp entirely: the alarm still
# writes to Firestore and the live map still updates, so the demo degrades to
# one screen instead of two rather than failing.
WA_BRIDGE_URL=http://127.0.0.1:8790
WA_BRIDGE_SECRET=

# Canonical public origin used inside every recipient tracking link. This is
# server-only and must remain public HTTPS even when Pukaar runs on localhost.
PUBLIC_TRACKING_ORIGIN=https://pukaar-web-wine.vercel.app

# Port the relay listens on. Also read by apps/web to know where to connect.
RELAY_PORT=8787

# Groq (https://console.groq.com/keys) answers open-ended chat questions the
# deterministic FAQ below does not cover. Grounded in the app's own facts via
# a system prompt, so it explains the product, it does not invent claims
# about it. Optional: without it, the chat still answers its known six
# questions instantly and tells the user what it can answer for anything else.
GROQ_API_KEY=
