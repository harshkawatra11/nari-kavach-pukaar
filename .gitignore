node_modules/
.pnpm-store/

# Next.js
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Turbo
.turbo/

# Build outputs
dist/
build/

# Env files - never commit real secrets
.env
.env.local
.env*.local
!.env.example

# Never commit a service account key. The private key lives in .env.local as a
# single-line value; there is no JSON key file anywhere in this repo by design.
*-sa.json
*.json.key
serviceAccount*.json

# Demo recordings and stage screenshots that are not part of the docs set
/recordings/

