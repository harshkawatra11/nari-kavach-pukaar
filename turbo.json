{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "FIREBASE_PROJECT_ID",
        "FIREBASE_CLIENT_EMAIL",
        "FIREBASE_PRIVATE_KEY",
        "GROQ_API_KEY",
        "RELAY_SHARED_SECRET",
        "SARVAM_API_KEY",
        "SARVAM_LANGUAGE",
        "SARVAM_SPEAKER",
        "STT_MODE",
        "TTS_MODE",
        "PUBLIC_TRACKING_ORIGIN"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {},
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
